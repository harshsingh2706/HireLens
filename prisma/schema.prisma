// Prisma Schema for HireLens AI Recruitment Intelligence Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String?
  company      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  jobs         Job[]
  candidates   Candidate[]

  @@map("users")
}

model Job {
  id                 String        @id @default(cuid())
  recruiterId        String
  title              String
  description        String        @db.Text
  location           String?
  employmentType     String?
  experienceMinYears Int?
  status             String        @default("ACTIVE")
  structuredJd       Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  recruiter          User          @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  skills             JobSkill[]
  applications       Application[]

  @@index([recruiterId])
  @@index([status])
  @@map("jobs")
}

model Candidate {
  id              String           @id @default(cuid())
  recruiterId     String
  name            String
  email           String?
  phone           String?
  headline        String?
  summary         String?          @db.Text
  experienceYears Float?
  structuredData  Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recruiter       User             @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  resumes         Resume[]
  skills          CandidateSkill[]
  applications    Application[]

  @@index([recruiterId])
  @@index([email])
  @@map("candidates")
}

model Resume {
  id               String    @id @default(cuid())
  candidateId      String
  fileName         String
  fileSize         Int
  mimeType         String
  fileUrl          String
  extractedText    String?   @db.Text
  processingStatus String    @default("PENDING")
  errorMessage     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("resumes")
}

model Skill {
  id              String           @id @default(cuid())
  name            String           @unique
  displayName     String
  category        String?
  createdAt       DateTime         @default(now())
  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]

  @@index([name])
  @@map("skills")
}

model CandidateSkill {
  id                String    @id @default(cuid())
  candidateId       String
  skillId           String
  yearsOfExperience Float?
  contextEvidence   String?   @db.Text
  createdAt         DateTime  @default(now())
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill             Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@index([candidateId])
  @@index([skillId])
  @@map("candidate_skills")
}

model JobSkill {
  id         String   @id @default(cuid())
  jobId      String
  skillId    String
  isRequired Boolean  @default(true)
  minYears   Float?
  createdAt  DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
  @@map("job_skills")
}

model Application {
  id             String    @id @default(cuid())
  jobId          String
  candidateId    String
  status         String    @default("NEW")
  matchScore     Float?
  matchAnalysis  Json?
  recruiterNotes String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([status])
  @@map("applications")
}
