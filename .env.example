# ==========================================
# HireLens Environment Variables Example
# ==========================================

# PostgreSQL Connection URL
# Standard connection format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hirelens?schema=public"

# NextAuth / Auth.js Secret for JWT and session signing
# Generate with: openssl rand -base64 32 or npx auth secret
AUTH_SECRET="your-32-character-secret-key-here"

# OpenAI API Configuration (Phase 9 Resume Structuring)
# Obtain your key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
# Configurable model (defaults to gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"
